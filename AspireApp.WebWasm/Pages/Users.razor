@page "/users"
@using AspireApp.WebWasm.Authentication
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Users</PageTitle>

<AuthBody Title="User Management">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Welcome @(authContext?.UserName ?? "User")! This is the user management page.
    </MudAlert>

    <MudText Typo="Typo.h4" Class="mb-4">User Management Dashboard</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">User Statistics</MudText>
                <MudList T="string">
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-3" />
                        <MudText>Total Users: 1,247</MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-3" />
                        <MudText>New Users This Month: 23</MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-3" />
                        <MudText>Admin Users: 5</MudText>
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">
                        Add User
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Search">
                        Search Users
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Download">
                        Export Users
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (authContext?.IsAdmin == true)
    {
        <MudDivider Class="my-4" />
        
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Admin Actions</MudText>
            <MudAlert Severity="Severity.Success" Class="mb-3">
                You have admin privileges and can perform advanced user management tasks.
            </MudAlert>
            
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Security">
                    Manage Roles
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block">
                    Bulk Actions
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Analytics">
                    User Analytics
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</AuthBody>

@code {
    [CascadingParameter]
    private MainLayout.AuthContext authContext { get; set; }
} 