@page "/weather"
@inject HttpClient Http
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using AspireApp.WebWasm.Authentication
@attribute [Authorize]

<PageTitle>Weather</PageTitle>

<AuthBody Title="Weather Data">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Hello @(authContext?.UserName ?? "User")! Here's the current weather information.
    </MudAlert>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-3">Weather Forecast</MudText>
        <MudText Typo="Typo.body1">
            Weather data will be displayed here when the weather service is implemented.
        </MudText>
    </MudPaper>
</AuthBody>

@code {
    [CascadingParameter]
    private MainLayout.AuthContext? authContext { get; set; }
}
