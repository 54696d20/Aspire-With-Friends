@page "/counter"
@using AspireApp.WebWasm.Authentication
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Counter</PageTitle>

<AuthBody Title="Counter Page - Protected Content">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Hello @(authContext?.UserName ?? "User")! This is a protected counter page.
    </MudAlert>

    <h1>Counter</h1>

    <p role="status">Current count: @currentCount</p>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IncrementCount" Class="mr-2">
        Click me
    </MudButton>
    
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DivideByZero">
        Divide By Zero
    </MudButton>
</AuthBody>

@code {
    private int currentCount = 0;

    [CascadingParameter]
    private MainLayout.AuthContext authContext { get; set; }

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DivideByZero(MouseEventArgs args)
    {
        var zero = 0;
        var i = 10 / zero;
    }
}
