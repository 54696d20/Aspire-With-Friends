@page "/security"
@using AspireApp.WebWasm.Authentication
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Security</PageTitle>

<AuthBody Title="Security Management">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Welcome @(authContext?.UserName ?? "User")! This is the security management page.
    </MudAlert>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-3">Security Status</MudText>
        <MudGrid>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: linear-gradient(45deg, #388e3c, #66bb6a); color: white;">
                    <MudText Typo="Typo.h4">✓</MudText>
                    <MudText Typo="Typo.body2">Authentication</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: linear-gradient(45deg, #388e3c, #66bb6a); color: white;">
                    <MudText Typo="Typo.h4">✓</MudText>
                    <MudText Typo="Typo.body2">Authorization</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: linear-gradient(45deg, #f57c00, #ff9800); color: white;">
                    <MudText Typo="Typo.h4">!</MudText>
                    <MudText Typo="Typo.body2">SSL/TLS</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: linear-gradient(45deg, #388e3c, #66bb6a); color: white;">
                    <MudText Typo="Typo.h4">✓</MudText>
                    <MudText Typo="Typo.body2">Firewall</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h5" Class="mb-3">Security Actions</MudText>
        <MudGrid>
            <MudItem xs="6" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Security">
                    Security Scan
                </MudButton>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Update">
                    Update Security
                </MudButton>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" FullWidth="true" StartIcon="@Icons.Material.Filled.History">
                    Audit Log
                </MudButton>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" StartIcon="@Icons.Material.Filled.Report">
                    Report Issue
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (authContext?.IsAdmin == true)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h5" Class="mb-3">Admin Security Controls</MudText>
            <MudList T="string">
                <MudListItem T="string" Icon="@Icons.Material.Filled.AdminPanelSettings">
                    Configure security policies and rules
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Security">
                    Manage user access controls
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Analytics">
                    View security analytics and reports
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Settings">
                    System security configuration
                </MudListItem>
            </MudList>
        </MudPaper>
    }
</AuthBody>

@code {
    [CascadingParameter]
    private MainLayout.AuthContext? authContext { get; set; }
} 