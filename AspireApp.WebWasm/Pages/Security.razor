@page "/security"
@using AspireApp.WebWasm.Authentication
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Security</PageTitle>

<AuthBody Title="Security Management">
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Welcome @(authContext?.UserName ?? "User")! This is the security management page.
    </MudAlert>

    <MudText Typo="Typo.h4" Class="mb-4">Security Dashboard</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Security Status</MudText>
                <MudList T="string">
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Success" Class="mr-3" />
                        <MudText>Authentication: Active</MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Class="mr-3" />
                        <MudText>Authorization: Enabled</MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Success" Class="mr-3" />
                        <MudText>Keycloak: Connected</MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Class="mr-3" />
                        <MudText>Session Timeout: 30 minutes</MudText>
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Security Actions</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Password">
                        Change Password
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.TwoWheeler">
                        2FA Setup
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.History">
                        Login History
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (authContext?.IsAdmin == true)
    {
        <MudDivider Class="my-4" />
        
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Admin Security Controls</MudText>
            <MudAlert Severity="Severity.Success" Class="mb-3">
                You have admin privileges and can manage system-wide security settings.
            </MudAlert>
            
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">Access Control</MudText>
                            <MudText Typo="Typo.body2">Manage user permissions and roles</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                                Manage
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">Audit Logs</MudText>
                            <MudText Typo="Typo.body2">View system security events</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small">
                                View Logs
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">Security Policies</MudText>
                            <MudText Typo="Typo.body2">Configure security rules and policies</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small">
                                Configure
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</AuthBody>

@code {
    [CascadingParameter]
    private MainLayout.AuthContext authContext { get; set; }
} 