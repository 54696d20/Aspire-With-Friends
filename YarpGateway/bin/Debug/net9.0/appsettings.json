{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "YarpGateway": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "myweather-route": {
        "ClusterId": "myweather-cluster",
        "Match": {
          "Path": "/myweather-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/myweather-api"
          }
        ],
        "Metadata": {
          "Description": "Weather API route"
        }
      },
      "masterdata-route": {
        "ClusterId": "masterdata-cluster",
        "Match": {
          "Path": "/masterdata-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/masterdata-api"
          }
        ],
        "Metadata": {
          "Description": "Master Data API route with CQRS"
        }
      }
    },
    "Clusters": {
      "myweather-cluster": {
        "Destinations": {
          "myweatherapi-destination": {
            "Address": "http://localhost:5062/"
          }
        }
      },
      "masterdata-cluster": {
        "Destinations": {
          "masterdataapi-destination": {
            "Address": "http://localhost:5316/"
          }
        }
      }
    }
  }
}
